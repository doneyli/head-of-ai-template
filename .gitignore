# Runtime data (regenerated by scoring runs)
data/
!data/.gitkeep

# SQLite databases (created at runtime)
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Environment + secrets (never commit these)
.env
.env.*
*.pem
*.key
secrets/
credentials.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Logs
*.log
logs/

# Local Claude state (if any spills into the repo)
.claude/local/
.claude/memory/
